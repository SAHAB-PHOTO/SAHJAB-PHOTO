# ───────────────────────────────────────────────────────────────
# مفاتيح بوابات الدفع (تُملأ عند التكامل الحقيقي لاحقاً)
# Payment gateway keys — fill these when going live.
# ───────────────────────────────────────────────────────────────

# SATIM — الدفع ببطاقة CIB / الذهبية (Edahabia)
VITE_SATIM_MERCHANT_ID=
SATIM_API_USER=
SATIM_API_PASSWORD=
SATIM_RETURN_URL=

# BaridiMob / Algérie Poste
VITE_BARIDIMOB_MERCHANT_ID=

# Stripe — بطاقات Visa / MasterCard الدولية
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
VITE_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# (اختياري) العملات الرقمية USDT/BTC عبر مزود خارجي
CRYPTO_PROVIDER_API_KEY=

# ───────────────────────────────────────────────────────────────
# شركات التوصيل (API لإنشاء الطرود وتتبّعها)
# Delivery couriers — order creation & tracking APIs.
# ───────────────────────────────────────────────────────────────
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
ZREXPRESS_API_TOKEN=
MAYSTRO_API_KEY=
NOEST_API_TOKEN=

# ───────────────────────────────────────────────────────────────
# إشعارات حالة الطلب (SMS / WhatsApp / Email)
# Order status notifications.
# ───────────────────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
